# Preserve the discussion snapshot bytes and its documented SHA-256 on checkout.
docs/discussion/source-messages.json text eol=lf
# Keep K001 JSON checksums reproducible across Windows/Linux checkouts.
data/experiments/stone/*.json text eol=lf
docs/manual/evidence/stone/*.json text eol=lf
# Keep the independent K003 records and evidence checksums portable.
data/experiments/nut/*.json text eol=lf
docs/manual/evidence/nut/*.json text eol=lf
docs/manual/evidence/nut-revision/*.json text eol=lf
# Preserve downloaded distributions and the measured input byte-for-byte.
/app/static/vendor/*.js -text
/docs/manual/evidence/layout/geometry-input.json text eol=lf
# Archived branch snapshots retain their original Git bytes across checkouts.
/archive/observational-composition/** text eol=lf
# CoNLL-U sentence blocks intentionally end with a blank separator line.
/archive/observational-composition/results/004/parsed_input.conllu whitespace=-blank-at-eof
# Keep M007 lexical/evidence checksums stable across checkouts.
/data/dictionary/*.json text eol=lf
/docs/manual/evidence/builder/*.json text eol=lf
/docs/manual/evidence/builder/unit-tests.txt -text
